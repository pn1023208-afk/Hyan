# System User token lay tu Business Manager > System Users > Generate New Token.
# Chon dung app, va tick cac quyen: pages_show_list, pages_read_engagement,
# pages_manage_posts, pages_manage_engagement, pages_read_user_content,
# read_insights, ads_read, ads_management, business_management
FB_ACCESS_TOKEN=

# Chi can khi dung "token:extend" de doi token ca nhan ngan han lay token ~60 ngay.
# Lay tai: developers.facebook.com -> app -> Cai dat -> Co ban.
# App phai dung la app da cap FB_ACCESS_TOKEN, lech app la Facebook tu choi.
FB_APP_ID=
FB_APP_SECRET=

# ID cua fanpage. Lay bang: npm run fb -- pages:list
FB_PAGE_ID=

# ID tai khoan quang cao. Co hoac khong co tien to "act_" deu duoc.
# Lay bang: npm run fb -- ads:accounts
FB_AD_ACCOUNT_ID=

# Pin cung phien ban API. Kiem tra changelog cua Meta va cap nhat dinh ky:
# https://developers.facebook.com/docs/graph-api/changelog
FB_API_VERSION=v23.0
